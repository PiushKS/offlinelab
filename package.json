{
  "name": "offlinelab",
  "version": "0.1.0",
  "description": "OfflineLab: Break the network. Not your app. A local-first CLI and TypeScript framework for testing offline behavior, PWA resilience, and network faults.",
  "keywords": [
    "offline",
    "pwa",
    "service-worker",
    "network-testing",
    "fault-injection",
    "playwright",
    "resilience",
    "cli",
    "testing",
    "indexeddb"
  ],
  "homepage": "https://github.com/PiushKS/offlinelab#readme",
  "bugs": {
    "url": "https://github.com/PiushKS/offlinelab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiushKS/offlinelab.git"
  },
  "license": "MIT",
  "author": "OfflineLab Contributors",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "offlinelab": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests fixtures examples",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:compatibility": "vitest run tests/compatibility",
    "test:coverage": "vitest run tests/unit --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.51.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.22.0",
    "globals": "^17.14.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.0.9"
  }
}
